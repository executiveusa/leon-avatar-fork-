# Main settings of Leon
# https://docs.getleon.ai/configuration
#
# RAILWAY ZERO-SECRETS DEPLOYMENT:
# This configuration file is optimized for Railway deployment without any API keys.
# All optional third-party integrations are disabled by default.
# See RAILWAY_DEPLOYMENT.md for deployment guide.
# See .agents file for complete secrets specification.
# See master.secrets.json.template for local secret management.

# ============================================================================
# CORE SETTINGS (Required)
# ============================================================================

# Language currently used
LEON_LANG=en-US

# Server
# For Railway: Set to ${{ RAILWAY_PUBLIC_DOMAIN }}
# For local: http://localhost
LEON_HOST=http://localhost
LEON_PORT=1337

# Time zone (current one by default)
LEON_TIME_ZONE=

# ============================================================================
# LLM (Large Language Model) - OPTIONAL, DISABLED BY DEFAULT
# ============================================================================
# Zero-Secrets Mode: Keep LLM disabled to avoid requiring API keys
# To enable: Set LEON_LLM=true and provide LEON_LLM_PROVIDER_API_KEY
# Supported providers: local (no API key), groq, openai, anthropic

# Enable/disable LLM
LEON_LLM=false

# LLM provider
LEON_LLM_PROVIDER=local

# LLM provider API key (if not local)
# For zero-secrets deployment: Leave empty
# For full features: Obtain from provider and add to Railway secrets
LEON_LLM_PROVIDER_API_KEY=

# Enable/disable LLM natural language generation
LEON_LLM_NLG=false

# Enable/disable LLM Action Recognition
# Can fallback to chit-chat if no action is recognized
LEON_LLM_ACTION_RECOGNITION=false

# ============================================================================
# SPEECH FEATURES - OPTIONAL, DISABLED BY DEFAULT
# ============================================================================
# Zero-Secrets Mode: Speech features disabled to avoid external dependencies
# Local providers (coqui-stt, flite) work offline but increase resource usage
# Cloud providers (google-cloud, watson, polly) require API keys

# Enable/disable after speech
LEON_AFTER_SPEECH=false

# Enable/disable Leon's wake word
LEON_WAKE_WORD=false

# Enable/disable Leon's speech-to-text
LEON_STT=false

# Speech-to-text provider
# Options: coqui-stt (local), google-cloud-stt (requires credentials), watson-stt (requires credentials)
LEON_STT_PROVIDER=coqui-stt

# Enable/disable Leon's text-to-speech
LEON_TTS=false

# Text-to-speech provider
# Options: flite (local), google-cloud-tts (requires credentials), amazon-polly (requires credentials), watson-tts (requires credentials)
LEON_TTS_PROVIDER=flite

# ============================================================================
# HTTP API - ENABLED FOR WEB INTERFACE
# ============================================================================

# Enable/disable skills to be available over HTTP
LEON_OVER_HTTP=true

# HTTP API key (use "npm run generate:http-api-key" to regenerate one)
# For zero-secrets deployment: Leave empty, will auto-generate on first boot
# For production: Generate with npm script and add to Railway secrets
LEON_HTTP_API_KEY=

# Language used for the HTTP API
LEON_HTTP_API_LANG=en-US

# ============================================================================
# TELEMETRY & PRIVACY
# ============================================================================

# Enable/disable telemetry
# Zero-Secrets Mode: Disabled for privacy
LEON_TELEMETRY=false

# ============================================================================
# PYTHON TCP SERVER
# ============================================================================

# Python TCP server
LEON_PY_TCP_SERVER_HOST=0.0.0.0
LEON_PY_TCP_SERVER_PORT=1342

# Path to the Pipfile
PIPENV_PIPFILE=tcp_server/src/Pipfile

# Path to the virtual env in .venv/
PIPENV_VENV_IN_PROJECT=true

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================
# These variables are typically set by the deployment platform

# Node environment (development, production, testing)
# NODE_ENV=production

# ============================================================================
# EXTERNAL SERVICE CREDENTIALS (OPTIONAL - NOT USED IN ZERO-SECRETS MODE)
# ============================================================================
# These are only needed if enabling cloud-based TTS/STT services
# Keep empty for zero-secrets deployment

# Google Cloud credentials (for google-cloud-tts, google-cloud-stt)
# GOOGLE_APPLICATION_CREDENTIALS=

# AWS credentials (for amazon-polly)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# IBM Watson credentials (for watson-tts, watson-stt)
# WATSON_TTS_API_KEY=
# WATSON_TTS_URL=
# WATSON_STT_API_KEY=
# WATSON_STT_URL=

# ============================================================================
# ZERO-SECRETS DEPLOYMENT CHECKLIST
# ============================================================================
# ✓ LEON_LLM=false (no external LLM)
# ✓ LEON_STT=false (no speech-to-text)
# ✓ LEON_TTS=false (no text-to-speech)
# ✓ LEON_TELEMETRY=false (privacy first)
# ✓ LEON_OVER_HTTP=true (web interface enabled)
# ✓ All API keys empty (no secrets required)
#
# Features enabled with zero-secrets:
# - Web interface
# - HTTP API
# - Basic conversation
# - Games (Akinator, Rock-Paper-Scissors, Guess the Number)
# - Utilities (Date/Time, Timer, Speed Test, Translator)
# - Productivity (Todo List)
# - Offline operation
#
# See RAILWAY_DEPLOYMENT.md for complete deployment guide
